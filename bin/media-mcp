#!/usr/bin/env python3
"""MCP server (stdio) that cuts pieces out of a saved audio or video file with ffmpeg, by timecodes, and returns the
pieces' paths (to attach, transcribe or share). It runs only ffmpeg and ffprobe, with fixed arguments and no shell,
on files in the folders where Telegram, WhatsApp, Google and Zoom downloads are saved. Needs ffmpeg.

Settings (environment): MEDIA_DIRS (colon-separated folders a file may come from; default below), MEDIA_OUT
(default ~/nudnik/clips).
"""
import json
import os
import re
import subprocess
import sys
import time

DIRS = [os.path.realpath(os.path.expanduser(d)) for d in os.environ.get(
    "MEDIA_DIRS",
    "~/.claude/channels/telegram/inbox:~/.claude/projects:/var/lib/nudnik-google/attachments:/var/lib/nudnik-zoom/downloads:~/nudnik/clips").split(":")
    if d]
OUT = os.path.expanduser(os.environ.get("MEDIA_OUT", "~/nudnik/clips"))
TC = re.compile(r"^(\d{1,2}:)?(\d{1,2}:)?\d{1,2}(\.\d{1,3})?$")
FORMATS = {"mp3": ["-vn", "-c:a", "libmp3lame", "-q:a", "4"],      # small, plays everywhere
           "m4a": ["-vn", "-c:a", "aac", "-b:a", "128k"],
           "wav": ["-vn", "-c:a", "pcm_s16le"],
           "mp4": ["-c:v", "libx264", "-preset", "veryfast", "-crf", "26", "-c:a", "aac", "-b:a", "128k"]}

TOOLS = [
    {"name": "cut_audio",
     "description": "Cut pieces out of a saved audio or video file (a Zoom or meeting recording, a voice note, a Drive "
                    "or mail attachment) by timecodes, and get each piece as a file to attach, transcribe or share. "
                    "Timecodes: SS, MM:SS or H:MM:SS, optional .fraction. format: mp3 (default), m4a, wav, or mp4 "
                    "(keeps the video). With no pieces it only reports the file's length.",
     "inputSchema": {"type": "object", "properties": {
         "path": {"type": "string", "description": "Path of the saved file"},
         "pieces": {"type": "array", "maxItems": 50, "items": {"type": "object", "properties": {
             "start": {"type": "string"}, "end": {"type": "string"},
             "name": {"type": "string", "description": "Optional short name for the piece"}},
             "required": ["start", "end"]}},
         "format": {"type": "string", "enum": sorted(FORMATS)}},
         "required": ["path"]}},
]


def allowed(path):
    real = os.path.realpath(os.path.expanduser(path))
    for d in DIRS:
        if real.startswith(d + os.sep):
            # under ~/.claude/projects only the files tools saved, never session transcripts or settings
            if d.endswith("/.claude/projects") and "/tool-results/" not in real:
                continue
            if os.path.isfile(real):
                return real
            raise RuntimeError("no such file")
    raise RuntimeError("only files saved from Telegram, WhatsApp, Google or Zoom (or earlier clips) can be cut")


def seconds(tc):
    if not TC.match(tc.strip()):
        raise RuntimeError(f"not a timecode: {tc!r} (use SS, MM:SS or H:MM:SS)")
    s = 0.0
    for part in tc.strip().split(":"):
        s = s * 60 + float(part)
    return s


def stamp(s):
    s = int(s)
    return f"{s // 3600}:{s % 3600 // 60:02d}:{s % 60:02d}" if s >= 3600 else f"{s // 60}:{s % 60:02d}"


def length(path):
    r = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "json", "--", path],
                       capture_output=True, timeout=60)
    try:
        return float(json.loads(r.stdout)["format"]["duration"])
    except (ValueError, KeyError):
        raise RuntimeError("ffmpeg can't read this file as audio or video") from None


def cut(a):
    src = allowed(a["path"])
    total = length(src)
    pieces = a.get("pieces") or []
    if not pieces:
        return f"{os.path.basename(src)}: {stamp(total)} long."
    fmt = a.get("format") or "mp3"
    if fmt not in FORMATS:
        raise RuntimeError(f"format must be one of {', '.join(sorted(FORMATS))}")
    base = re.sub(r"[^\w.-]", "_", os.path.splitext(os.path.basename(src))[0])[:40]
    os.makedirs(OUT, mode=0o750, exist_ok=True)
    ts = time.strftime("%Y%m%d-%H%M%S")
    lines = []
    for i, p in enumerate(pieces, 1):
        start, end = seconds(p["start"]), seconds(p["end"])
        if not 0 <= start < end:
            raise RuntimeError(f"piece {i}: start must be before end")
        if start >= total:
            raise RuntimeError(f"piece {i} starts after the end of the file ({stamp(total)})")
        name = re.sub(r"[^\w.-]", "_", p.get("name") or "")[:40]
        out = os.path.join(OUT, f"{ts}-{base}-{i:02d}{'-' + name if name else ''}.{fmt}")
        r = subprocess.run(["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error", "-ss", str(start),
                            "-t", str(min(end, total) - start), "-i", src, *FORMATS[fmt], "-y", out],
                           capture_output=True, timeout=1800)
        if r.returncode or not os.path.exists(out):
            raise RuntimeError(f"piece {i}: ffmpeg failed: {r.stderr.decode(errors='replace').strip()[-300:]}")
        mb = os.path.getsize(out) / 1e6
        lines.append(f"{i}. {stamp(start)}–{stamp(min(end, total))} → {out} ({mb:.1f} MB"
                     f"{', over Telegram’s 50 MB limit' if mb > 50 else ''})")
    return f"{os.path.basename(src)} ({stamp(total)} long), {len(lines)} piece(s):\n" + "\n".join(lines)


def handle(msg):
    method, mid = msg.get("method"), msg.get("id")
    if mid is None:
        return None
    if method == "initialize":
        result = {"protocolVersion": msg.get("params", {}).get("protocolVersion", "2025-06-18"),
                  "capabilities": {"tools": {}}, "serverInfo": {"name": "media", "version": "1"}}
    elif method == "tools/list":
        result = {"tools": TOOLS}
    elif method == "tools/call":
        p = msg.get("params", {})
        try:
            if p.get("name") != "cut_audio":
                raise RuntimeError("unknown tool")
            result = {"content": [{"type": "text", "text": cut(p.get("arguments") or {})}]}
        except (RuntimeError, KeyError, OSError, ValueError, subprocess.TimeoutExpired) as e:
            result = {"content": [{"type": "text", "text": f"Error: {e}"}], "isError": True}
    elif method == "ping":
        result = {}
    else:
        return {"jsonrpc": "2.0", "id": mid, "error": {"code": -32601, "message": "method not found"}}
    return {"jsonrpc": "2.0", "id": mid, "result": result}


for raw in sys.stdin:
    if raw.strip():
        reply = handle(json.loads(raw))
        if reply:
            sys.stdout.write(json.dumps(reply, ensure_ascii=False) + "\n")
            sys.stdout.flush()
