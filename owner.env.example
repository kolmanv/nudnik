# Copy to ~/.config/nudnik/owner.env (mode 600, never commit). Sourced by bin/nudnik, imported by CLAUDE.md.
OWNER_NAME="Your Name"
BRIEFING_LANG="English"            # language of briefings and task titles
TZ_NAME="UTC"                      # timezone for the timer, e.g. Europe/London
BRIEFING_TIME="07:30"              # local time of the morning briefing
TELEGRAM_CHAT_ID=""                # your chat id with the bot (the bot can only send here)
IGNORE_CHATS=""                    # WhatsApp chats never to report, comma-separated names
MAIL_TOOLS=""                      # read-only mail MCP tools to allow, space-separated (empty = no mail yet)
