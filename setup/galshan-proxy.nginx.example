# /etc/nginx/conf.d/galshan-proxy.conf (root, mode 600): local proxy to galshan, the read-only browser API. It adds
# nudnik's galshan key to every request, so the assistant user browses without ever seeing the key.
# The container's firewall must allow this one address and port out (it blocks the home network otherwise).
server {
    listen 127.0.0.1:8773;
    location ~ ^/(browse|health)$ {
        proxy_pass http://<galshan address>:8790;
        proxy_set_header Authorization "Bearer <key from: galshan-api token nudnik>";
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 300s;
    }
    location / { return 404; }
}
